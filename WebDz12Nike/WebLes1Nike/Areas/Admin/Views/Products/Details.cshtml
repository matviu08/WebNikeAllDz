@model ProductDetailVM
@{
    var imagesDir = Configuration.GetRequiredSection("ImagesDir").Get<string>() ?? "myimages";
}
@{
ViewData["Title"] = Model?.Name;
var hasImages = Model != null && Model.Images.Count > 0;
var mainImage = hasImages ? Model!.Images.First() : null;
}

@if (Model == null)
{
<div class="card">
    <div class="card-body text-center py-5">
        <i class="icon-base ri ri-error-warning-line icon-48px text-danger mb-3 d-block"></i>
        <h4 class="mb-2">Товар не знайдено</h4>
        <p class="text-muted mb-4">Можливо, він був видалений або посилання застаріло.</p>
        <a asp-action="Index" class="btn btn-primary">
            <i class="icon-base ri ri-arrow-left-line me-1"></i>До списку товарів
        </a>
    </div>
</div>
}
else
{
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted d-inline-flex align-items-center mb-2">
            <i class="icon-base ri ri-arrow-left-line me-1"></i>До списку товарів
        </a>
        <h4 class="fw-bold mb-0">@Model.Name</h4>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ProdEdit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="icon-base ri ri-pencil-line me-1"></i>Редагувати
        </a>
        <button type="button"
                class="btn btn-outline-danger"
                data-bs-toggle="modal"
                data-bs-target="#confirmDeleteProduct">
            <i class="icon-base ri ri-delete-bin-6-line me-1"></i>Видалити
        </button>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <div class="rounded-3 overflow-hidden mb-3 bg-label-secondary d-flex align-items-center justify-content-center"
                     style="aspect-ratio: 1 / 1;">
                    @if (hasImages)
                    {
                    <img id="mainImage"
                         src="/@imagesDir/@(mainImage)_1200.webp"
                         class="w-100 h-100"
                         style="object-fit: cover;"
                         alt="@Model.Name" />
                    }
                    else
                    {
                    <i class="icon-base ri ri-image-line icon-48px text-muted"></i>
                    }
                </div>

                @if (Model.Images.Count > 1)
                {
                <div class="d-flex gap-2 flex-wrap">
                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                    <img src="/@imagesDir/@(Model.Images[i])_432.webp"
                         class="thumb-item rounded border @(i == 0 ? "border-primary border-2" : "")"
                         data-index="@i"
                         style="width: 64px; height: 64px; object-fit: cover; cursor: pointer;"
                         alt="@Model.Name" />
                    }
                </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card mb-4">
            <div class="card-body">
                <span class="badge rounded-pill bg-label-dark mb-3">@Model.CategoryName</span>
                <h2 class="fw-bold text-primary mb-4">@Model.Price</h2>

                <table class="table table-borderless mb-0">
                    <tbody>
                    <tr>
                        <td class="text-muted ps-0" style="width: 160px;">ID товару</td>
                        <td class="fw-medium">#@Model.Id</td>
                    </tr>
                    <tr>
                        <td class="text-muted ps-0">Категорія</td>
                        <td class="fw-medium">@Model.CategoryName</td>
                    </tr>
                    <tr>
                        <td class="text-muted ps-0">Кількість фото</td>
                        <td class="fw-medium">@Model.Images.Count</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <h5 class="card-header">Опис товару</h5>
            <div class="card-body">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                <p class="text-muted mb-0">Опис відсутній</p>
                }
                else
                {
                <div style="white-space: pre-line;">@Html.Raw(Model.Description)</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmDeleteProduct" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Підтвердіть видалення</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    Ви дійсно бажаєте видалити товар
                    <strong>«@Model.Name»</strong>?
                </p>
                <p class="text-danger mb-0">
                    Після видалення відновити його буде неможливо.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Скасувати</button>
                <form asp-action="ProdDelete" asp-route-id="@Model.Id" method="post" class="m-0">
                    <button type="submit" class="btn btn-danger">
                        <i class="icon-base ri ri-delete-bin-6-line me-1"></i>Видалити назавжди
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section PageScripts {
<script>
    (() => {
        const images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Images ?? new List<string>()));
        if (images.length < 2)
            return;

        const main = document.getElementById("mainImage");
        const thumbs = document.querySelectorAll(".thumb-item");

        function show(i) {
            main.src = `${window.IMAGES_BASE}/${images[i]}_1200.webp`;
            thumbs.forEach((t, index) => {
                t.classList.toggle("border-primary", index === i);
                t.classList.toggle("border-2", index === i);
            });
        }

        thumbs.forEach(t => {
            t.addEventListener("click", () => show(Number(t.dataset.index)));
        });
    })();
</script>
}